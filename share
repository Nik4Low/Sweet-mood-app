/* ============================================================
   ПЛАВНАЯ АНИМАЦИЯ ЛЕВОЙ ПАНЕЛИ (через трансформацию)
   ============================================================ */

/* Анимируем трансформацию и прозрачность */
.dark-theme #left-sidebar-container {
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
    will-change: transform, opacity;
}

/* Скрытое состояние — панель уезжает влево и становится прозрачной */
.dark-theme body.hide-left-sidebar #left-sidebar-container {
    transform: translateX(-100%) !important;
    opacity: 0 !important;
    /* Убираем возможный overflow, чтобы скрыть содержимое */
    overflow: hidden !important;
    /* Убираем pointer-events, чтобы нельзя было кликнуть по скрытой панели */
    pointer-events: none !important;
}

/* Видимое состояние — панель на месте */
.dark-theme body:not(.hide-left-sidebar) #left-sidebar-container {
    transform: translateX(0) !important;
    opacity: 1 !important;
    overflow: visible !important;
    pointer-events: auto !important;
}