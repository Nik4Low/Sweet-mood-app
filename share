/* ============================================================
   АНИМАЦИЯ ЛЕВОЙ ПАНЕЛИ (на основе реального left-sidebar.css)
   ============================================================ */

/* Анимируем все свойства, которые могут меняться при скрытии */
#left-sidebar-container {
    transition: width 0.4s ease-in-out,
                min-width 0.4s ease-in-out,
                max-width 0.4s ease-in-out,
                flex 0.4s ease-in-out,
                flex-basis 0.4s ease-in-out,
                transform 0.4s ease-in-out,
                opacity 0.4s ease-in-out !important;
    will-change: transform, opacity, width;
}

/* Когда панель скрыта (класс на body) */
body.hide-left-sidebar #left-sidebar-container {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    flex: 0 0 0 !important;
    flex-basis: 0 !important;
    transform: translateX(-100%) !important;
    opacity: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
}

/* Когда панель видна */
body:not(.hide-left-sidebar) #left-sidebar-container {
    width: var(--left-sidebar-width) !important;
    min-width: var(--left-sidebar-width) !important;
    max-width: var(--left-sidebar-max-width) !important;
    flex: 0 0 auto !important;
    flex-basis: var(--left-sidebar-width) !important;
    transform: translateX(0) !important;
    opacity: 1 !important;
    overflow: visible !important;
    pointer-events: auto !important;
}

/* Также анимируем контейнер прокрутки внутри панели */
#left_sidebar_scroll_container {
    transition: width 0.4s ease-in-out,
                opacity 0.4s ease-in-out !important;
}

body.hide-left-sidebar #left_sidebar_scroll_container {
    width: 0 !important;
    opacity: 0 !important;
    overflow: hidden !important;
}

body:not(.hide-left-sidebar) #left_sidebar_scroll_container {
    width: 100% !important;
    opacity: 1 !important;
}