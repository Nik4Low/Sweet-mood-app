/* ============================================================
   ПЛАВНАЯ АНИМАЦИЯ СВОРАЧИВАНИЯ ЛЕВОЙ ПАНЕЛИ
   ============================================================ */

/* Анимируем все свойства, которые могут меняться при скрытии/показе */
.dark-theme .column-left {
    transition: width 0.35s ease-in-out,
                min-width 0.35s ease-in-out,
                max-width 0.35s ease-in-out,
                flex 0.35s ease-in-out,
                flex-basis 0.35s ease-in-out,
                margin 0.35s ease-in-out,
                padding 0.35s ease-in-out,
                opacity 0.35s ease-in-out !important;
}

/* Состояние скрытой панели */
.dark-theme body.hide-left-sidebar .column-left {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    flex: 0 0 0 !important;
    flex-basis: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    opacity: 0 !important;
    overflow: hidden !important; /* скрываем содержимое, но анимация ширины всё равно будет */
}

/* Состояние видимой панели (используем переменные, которые вы задали) */
.dark-theme body:not(.hide-left-sidebar) .column-left {
    width: var(--left-sidebar-width) !important;
    min-width: var(--left-sidebar-width) !important;
    max-width: var(--left-sidebar-max-width) !important;
    flex: 0 0 auto !important;
    flex-basis: var(--left-sidebar-width) !important;
    opacity: 1 !important;
    overflow: visible !important;
}

/* ============================================================
   ПЛАВНАЯ АНИМАЦИЯ ПРАВОЙ ПАНЕЛИ (если нужно)
   ============================================================ */

.dark-theme .column-right {
    transition: width 0.35s ease-in-out,
                min-width 0.35s ease-in-out,
                max-width 0.35s ease-in-out,
                flex 0.35s ease-in-out,
                flex-basis 0.35s ease-in-out,
                margin 0.35s ease-in-out,
                padding 0.35s ease-in-out,
                opacity 0.35s ease-in-out !important;
}

.dark-theme body.hide-right-sidebar .column-right {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    flex: 0 0 0 !important;
    flex-basis: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    opacity: 0 !important;
    overflow: hidden !important;
}

.dark-theme body:not(.hide-right-sidebar) .column-right {
    width: var(--right-sidebar-width) !important;
    min-width: var(--right-sidebar-width) !important;
    max-width: var(--right-sidebar-max-width) !important;
    flex: 0 0 auto !important;
    flex-basis: var(--right-sidebar-width) !important;
    opacity: 1 !important;
    overflow: visible !important;
}